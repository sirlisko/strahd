---
import BaseLayout from './BaseLayout.astro';
import Backlinks from '../components/Backlinks.astro';

interface Props {
  title: string;
  description?: string;
  meta?: string;
  status?: string;
  tags?: string[];
  backlinksUrl: string;
  image?: string;
}
const { title, description, meta, tags = [], backlinksUrl, image } = Astro.props;
const status = Astro.props.status === 'vivo' ? undefined : Astro.props.status;

const sections: Record<string, string> = {
  diario: 'Diario',
  personaggi: 'Personaggi',
  png: 'Png',
  luoghi: 'Luoghi',
  riassunto: 'Riassunto',
};
const section = sections[backlinksUrl.split('/')[1]];
---
<BaseLayout title={title} description={description} type="article">
  <article data-pagefind-body data-pagefind-filter={section && `sezione:${section}`}>
    <header class="entry-header">
      {image && <img class="entry-image" src={image} alt={title} />}
      <h1 class="page-title" data-pagefind-weight="10">{title}</h1>
      {meta && <p class="entry-meta" data-pagefind-ignore>{meta}</p>}
      {(status || tags.length > 0) && (
        <div class="badge-row" data-pagefind-ignore>
          {status && <span class={`badge badge-${status}`}>{status}</span>}
          {tags.map((t) => <span class="badge">{t}</span>)}
        </div>
      )}
    </header>
    <div class="entry-content">
      <slot />
    </div>
    <div data-pagefind-ignore>
      <Backlinks url={backlinksUrl} />
      <slot name="after" />
    </div>
  </article>
</BaseLayout>
