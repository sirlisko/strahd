---
import { getCollection, render } from 'astro:content';
import EntryLayout from '../../layouts/EntryLayout.astro';

export async function getStaticPaths() {
  const npcs = await getCollection('png');
  return npcs.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { ruolo, luogo, fazione } = entry.data;
// Skip the place when the role already names it ("Serva della Villa del Borgomastro").
const meta = [ruolo, luogo && !ruolo?.includes(luogo) && luogo, fazione].filter(Boolean).join(' · ');
---
<EntryLayout
  title={entry.data.titolo}
  description={entry.data.estratto}
  meta={meta}
  status={entry.data.stato}
  tags={entry.data.tag}
  backlinksUrl={`/png/${entry.id}`}
>
  <Content />
</EntryLayout>
