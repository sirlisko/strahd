---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const npcs = (await getCollection('png')).sort((a, b) => a.data.titolo.localeCompare(b.data.titolo));
---
<BaseLayout title="PNG" description="I personaggi non giocanti incontrati dalla compagnia: alleati, nemici e figure misteriose.">
  <h1 class="page-title">Personaggi Non Giocanti</h1>
  <p class="page-lede">Alleati, nemici e comparse incontrate a Barovia.</p>
  <ul class="playbill">
    {npcs.map((p) => (
      <li>
        <a class="playbill-name" href={`/png/${p.id}`}>
          {p.data.titolo}
          {p.data.stato === 'morto' && (
            <><span class="playbill-dagger" aria-hidden="true">&dagger;</span><span class="sr-only">(morto)</span></>
          )}
        </a>
        <span class="playbill-role">
          {p.data.ruolo}
          {p.data.stato !== 'vivo' && p.data.stato !== 'morto' && (
            <>{p.data.ruolo && ' · '}<span class="playbill-status">{p.data.stato}</span></>
          )}
        </span>
      </li>
    ))}
  </ul>
</BaseLayout>
