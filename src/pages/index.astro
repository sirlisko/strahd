---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { toRoman, longDate } from '../lib/format';
import { fullPortrait } from '../lib/portraits';

const sessions = (await getCollection('sessions')).sort((a, b) => b.data.numero - a.data.numero);
const latest = sessions[0];

const characters = (await getCollection('personaggi')).sort((a, b) =>
  a.data.titolo.localeCompare(b.data.titolo)
);
const party = characters.filter((p) => fullPortrait(p.id));
---
<BaseLayout masthead>
  <p class="next-session" id="next-session" hidden>
    Prossima sessione: <span id="next-session-value"></span>
  </p>

  {latest && (
    <section class="latest-session">
      <p class="kicker kicker-split">
        <span>Ultima sessione · {toRoman(latest.data.numero)}</span>
        <span>{longDate(latest.data.data)}</span>
      </p>
      <h2><a href={`/diario/${latest.id}`}>{latest.data.titolo}</a></h2>
      {latest.data.estratto && <p class="drop-cap">{latest.data.estratto}</p>}
      <p class="read-more"><a href={`/diario/${latest.id}`}>Continua a leggere</a> &rarr;</p>
    </section>
  )}

  <script>
    const endpoint = 'https://cms.sirlisko.com/items/strahd';
    const item = document.getElementById('next-session');
    const valueEl = document.getElementById('next-session-value');

    fetch(endpoint)
      .then((res) => (res.ok ? res.json() : Promise.reject(res.status)))
      .then(({ data }) => {
        if (!data?.next_session || !item || !valueEl) return;
        const sessionDate = new Date(data.next_session);
        if (Number.isNaN(sessionDate.getTime())) return;
        if (sessionDate.getTime() < Date.now()) return; // already happened

        const day = sessionDate.toLocaleDateString('it-IT', {
          weekday: 'long',
          day: 'numeric',
          month: 'long',
        });
        const time = sessionDate.toLocaleTimeString('it-IT', {
          hour: '2-digit',
          minute: '2-digit',
        });

        valueEl.textContent = `${day} alle ${time}`;
        item.hidden = false;
      })
      .catch(() => {
        // CMS unreachable: leave the next session hidden.
      });
  </script>

  {party.length > 0 && (
    <section>
      <div class="ornament" aria-hidden="true">&#8258;</div>
      <h2 class="section-title">La compagnia</h2>
      <div class="cast-grid">
        {party.map((p) => (
          <a class="cast-portrait" href={`/personaggi/${p.id}`}>
            <img src={fullPortrait(p.id)} alt="" loading="lazy" />
            <span>{p.data.titolo}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section>
    <div class="ornament" aria-hidden="true">&#8258;</div>
    <h2 class="section-title">Indice delle sessioni</h2>
    <ol class="session-index">
      {sessions.map((s) => (
        <li>
          <span class="session-index-number">{toRoman(s.data.numero)}</span>
          <a href={`/diario/${s.id}`}>{s.data.titolo}</a>
          <span class="session-index-leader" aria-hidden="true"></span>
          <span class="session-index-date">
            {s.data.data.toLocaleDateString('it-IT', { day: 'numeric', month: 'short' })}
          </span>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
